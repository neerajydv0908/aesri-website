# Copy to .env.local and fill in when needed. Never commit real values.

# Where enquiries go. If unset, they are appended to data/enquiries/<school>.ndjson
# (fine on a single server; NOT suitable for serverless hosts such as Vercel).
# In the portal phase, point this at the portal's admissions intake endpoint.
ENQUIRY_FORWARD_URL=
ENQUIRY_FORWARD_TOKEN=

# Where enquiries are kept when they are not forwarded: an absolute folder outside the
# app, kept across updates and backed up. Empty = data/enquiries in the app folder.
ENQUIRY_DATA_DIR=

# How many proxies (nginx, a CDN) add to X-Forwarded-For in front of the site. The enquiry
# limits count the address the nearest one saw. 1 = nginx on the same machine (default).
TRUSTED_PROXY_HOPS=1

# The Campus Portal's address, used by "Portal login" and the /portal page.
# Built into the pages: set it before `npm run build`.
# Empty = https://portal.aesrischools.org (http://localhost:3001 with `npm run dev`).
NEXT_PUBLIC_PORTAL_URL=
